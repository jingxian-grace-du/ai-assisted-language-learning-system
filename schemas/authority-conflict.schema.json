{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authority-conflict.schema.json",
  "title": "Authority conflict and resolution",
  "type": "object",
  "required": ["conflict_id", "subject_id", "source_ids", "status", "detected_at", "privacy"],
  "properties": {
    "conflict_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "subject_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "source_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stable_id"}},
    "status": {"enum": ["unresolved", "resolved-from-authority", "resolved-by-learner", "superseded"]},
    "resolution_authority_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "resolution_reason": {"type": "string"},
    "detected_at": {"$ref": "common.schema.json#/$defs/iso_datetime"},
    "resolved_at": {"$ref": "common.schema.json#/$defs/iso_datetime"},
    "privacy": {"$ref": "common.schema.json#/$defs/privacy"}
  },
  "additionalProperties": false
}

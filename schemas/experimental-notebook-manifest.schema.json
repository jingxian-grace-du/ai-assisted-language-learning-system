{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experimental-notebook-manifest.schema.json",
  "title": "Experimental notebook manifest",
  "type": "object",
  "required": ["manifest_id", "session_id", "label", "specification", "unit_ids", "ledger_ids", "gate_result_ids", "anki_ready", "privacy"],
  "properties": {
    "manifest_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "session_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "label": {"const": "EXPERIMENTAL CANDIDATE — NOT APPROVED FOR ANKI"},
    "specification": {"const": "raw-material-processing-v0.1"},
    "unit_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stable_id"}},
    "ledger_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stable_id"}},
    "gate_result_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stable_id"}},
    "unresolved_conflict_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stable_id"}},
    "anki_ready": {"const": false},
    "privacy": {"$ref": "common.schema.json#/$defs/privacy"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anki-note.schema.json",
  "title": "Validated Anki note record",
  "type": "object",
  "required": ["anki_record_id", "notebook_unit_id", "note_type", "fields", "tags", "destination_deck", "source_date", "validation_result_ids", "privacy"],
  "properties": {
    "anki_record_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "notebook_unit_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "note_type": {"enum": ["OralDiary — Context Cloze", "OralDiary — Topic Retell", "OralDiary — Vocabulary", "OralDiary — Guidance"]},
    "fields": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "destination_deck": {"type": "string", "minLength": 1},
    "source_date": {"type": "string", "format": "date"},
    "validation_result_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/stable_id"}
    },
    "privacy": {"$ref": "common.schema.json#/$defs/privacy"}
  },
  "additionalProperties": false
}

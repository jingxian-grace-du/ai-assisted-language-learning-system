{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transformation.schema.json",
  "title": "Traceable content transformation",
  "type": "object",
  "required": ["transformation_id", "input_ids", "output_ids", "operation", "authority", "semantic_change_allowed", "performed_at"],
  "properties": {
    "transformation_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "input_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stable_id"}},
    "output_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stable_id"}},
    "operation": {"enum": ["correct", "naturalise", "consolidate", "split", "translate", "add-retrieval-markup", "remove-retrieval-markup", "format", "export"]},
    "authority": {"type": "string", "minLength": 1},
    "semantic_change_allowed": {"type": "boolean"},
    "change_summary": {"type": "string"},
    "performed_at": {"$ref": "common.schema.json#/$defs/iso_datetime"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "checkpoint-link.schema.json",
  "title": "Topic checkpoint linkage register",
  "type": "object",
  "required": ["register_id", "session_id", "links", "privacy"],
  "properties": {
    "register_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "session_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["checkpoint_id", "topic_id", "packet_id", "source_span_ids", "status"],
        "properties": {
          "checkpoint_id": {"$ref": "common.schema.json#/$defs/stable_id"},
          "topic_id": {"$ref": "common.schema.json#/$defs/stable_id"},
          "packet_id": {"$ref": "common.schema.json#/$defs/stable_id"},
          "source_span_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stable_id"}},
          "status": {"enum": ["locked", "blocked", "superseded"]}
        },
        "additionalProperties": false
      }
    },
    "privacy": {"$ref": "common.schema.json#/$defs/privacy"}
  },
  "additionalProperties": false
}

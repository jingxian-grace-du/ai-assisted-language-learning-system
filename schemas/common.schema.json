{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common English Oral Diary data definitions",
  "$defs": {
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "iso_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "source_range": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["classification", "repository_allowed"],
      "properties": {
        "classification": {"enum": ["private-learning-data", "synthetic", "aggregate-non-reconstructive"]},
        "repository_allowed": {"type": "boolean"},
        "retention_policy": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "private-learning-data"}}},
          "then": {"properties": {"repository_allowed": {"const": false}}}
        }
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_session_id", "source_span_ids"],
      "properties": {
        "source_session_id": {"$ref": "#/$defs/stable_id"},
        "source_span_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        },
        "authority_level": {"type": "string"},
        "transformation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        }
      },
      "additionalProperties": false
    }
  }
}

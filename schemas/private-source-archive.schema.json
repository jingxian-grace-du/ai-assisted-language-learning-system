{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "private-source-archive.schema.json",
  "title": "Private conversation source archive",
  "type": "object",
  "required": ["archive_id", "session_id", "segments", "completeness", "privacy"],
  "properties": {
    "archive_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "session_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "source_chat_id", "sequence", "role", "authoritative", "complete", "messages"],
        "properties": {
          "segment_id": {"$ref": "common.schema.json#/$defs/stable_id"},
          "source_chat_id": {"type": "string", "minLength": 1},
          "sequence": {"type": "integer", "minimum": 1},
          "role": {"enum": ["night-diary", "night-continuation", "morning-review", "derived-recovery"]},
          "authoritative": {"type": "boolean"},
          "complete": {"type": "boolean"},
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["message_id", "order", "speaker", "content"],
              "properties": {
                "message_id": {"type": "string", "minLength": 1},
                "order": {"type": "integer", "minimum": 1},
                "speaker": {"enum": ["learner", "assistant", "system-event"]},
                "content": {"type": "string", "minLength": 1},
                "created_at": {"$ref": "common.schema.json#/$defs/iso_datetime"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "completeness": {
      "type": "object",
      "required": ["status", "checked_segment_ids", "missing_ranges"],
      "properties": {
        "status": {"enum": ["complete", "partial", "unavailable"]},
        "checked_segment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/stable_id"}
        },
        "missing_ranges": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "privacy": {"$ref": "common.schema.json#/$defs/privacy"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-span-index.schema.json",
  "title": "Content-free source-span index",
  "type": "object",
  "required": ["index_id", "session_id", "spans", "privacy"],
  "properties": {
    "index_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "session_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["span_id", "order", "speaker", "substantive"],
        "properties": {
          "span_id": {"$ref": "common.schema.json#/$defs/stable_id"},
          "order": {"type": "integer", "minimum": 1},
          "speaker": {"enum": ["learner", "assistant", "system-event"]},
          "substantive": {"type": "boolean"},
          "topic_id": {"$ref": "common.schema.json#/$defs/stable_id"},
          "non_topic_disposition": {"type": "string", "minLength": 1}
        },
        "oneOf": [
          {"required": ["topic_id"], "not": {"required": ["non_topic_disposition"]}},
          {"required": ["non_topic_disposition"], "not": {"required": ["topic_id"]}}
        ],
        "additionalProperties": false
      }
    },
    "privacy": {"$ref": "common.schema.json#/$defs/privacy"}
  },
  "additionalProperties": false
}

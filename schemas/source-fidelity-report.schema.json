{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-fidelity-report.schema.json",
  "title": "Manual notebook source-fidelity report",
  "type": "object",
  "required": ["report_id", "session_id", "source_archive_id", "manual_notebook_id", "status", "checks", "conflict_ids", "reviewed_at", "privacy"],
  "properties": {
    "report_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "session_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "source_archive_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "manual_notebook_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "status": {"enum": ["pass", "blocked", "unresolved-conflicts-preserved"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "source_span_ids", "status", "evidence_reference"],
        "properties": {
          "check_id": {"$ref": "common.schema.json#/$defs/stable_id"},
          "gold_candidate_id": {"$ref": "common.schema.json#/$defs/stable_id"},
          "source_span_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/stable_id"}
          },
          "status": {"enum": ["pass", "fail", "unresolved"]},
          "evidence_reference": {"type": "string", "minLength": 1},
          "conflict_id": {"$ref": "common.schema.json#/$defs/stable_id"}
        },
        "additionalProperties": false
      }
    },
    "conflict_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/stable_id"}
    },
    "reviewed_at": {"$ref": "common.schema.json#/$defs/iso_datetime"},
    "privacy": {"$ref": "common.schema.json#/$defs/privacy"}
  },
  "additionalProperties": false
}

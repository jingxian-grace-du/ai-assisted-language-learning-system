{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pilot-bundle.schema.json",
  "title": "Phase 2 Shadow Mode pilot interchange bundle",
  "type": "object",
  "required": ["bundle_version", "bundle_id", "session_manifest", "source_span_index", "topic_evidence_packets", "checkpoint_register", "learning_signals", "candidate_ledgers", "experimental_notebook_manifest", "gate_results", "privacy"],
  "properties": {
    "bundle_version": {"const": "0.1.0"},
    "bundle_id": {"$ref": "common.schema.json#/$defs/stable_id"},
    "session_manifest": {"$ref": "session-manifest.schema.json"},
    "source_span_index": {"$ref": "source-span-index.schema.json"},
    "topic_evidence_packets": {"type": "array", "minItems": 1, "items": {"$ref": "topic-evidence-packet.schema.json"}},
    "checkpoint_register": {"$ref": "checkpoint-link.schema.json"},
    "learning_signals": {"type": "array", "items": {"$ref": "learning-signal.schema.json"}},
    "candidate_ledgers": {"type": "array", "minItems": 2, "items": {"$ref": "candidate-ledger.schema.json"}},
    "experimental_notebook_manifest": {"$ref": "experimental-notebook-manifest.schema.json"},
    "gate_results": {"type": "array", "minItems": 8, "items": {"$ref": "gate-result.schema.json"}},
    "privacy": {"$ref": "common.schema.json#/$defs/privacy"}
  },
  "additionalProperties": false
}

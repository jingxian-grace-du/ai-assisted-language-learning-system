{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/english-oral-diary/protocol/requirements.schema.json",
  "title": "English Oral Diary protocol requirement catalogue",
  "type": "object",
  "required": ["catalogue_version", "protocol_baseline", "requirements"],
  "properties": {
    "catalogue_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "protocol_baseline": {"type": "string"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "level", "stage", "statement", "source", "verification"],
        "properties": {
          "id": {"type": "string", "pattern": "^EOD-[A-Z]+-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 3},
          "level": {"enum": ["must", "should", "may"]},
          "stage": {
            "enum": [
              "system", "night", "morning", "selection", "notebook", "card-design",
              "validation", "archive", "export", "import", "post-cycle", "privacy"
            ]
          },
          "statement": {"type": "string", "minLength": 10},
          "source": {
            "type": "object",
            "required": ["protocol_version", "legacy_paragraphs"],
            "properties": {
              "protocol_version": {"const": "3.5"},
              "legacy_paragraphs": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "integer", "minimum": 1}
              }
            },
            "additionalProperties": false
          },
          "verification": {
            "type": "object",
            "required": ["method", "evidence"],
            "properties": {
              "method": {"enum": ["deterministic", "semantic", "operational", "human-decision"]},
              "evidence": {"type": "string", "minLength": 3}
            },
            "additionalProperties": false
          },
          "status": {"enum": ["baselined", "draft", "deprecated"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
